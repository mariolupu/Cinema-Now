@model WebApplication1.Models.Screening

@{
    ViewData["Title"] = "Add Showtime";
}

<div class="container py-5 text-light" style="max-width: 650px; min-height: 85vh;">
    <div class="card p-4 shadow-lg rounded-3 screening-form-card">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-10">
            <div>
                <h1 class="fw-bold text-white fs-3 m-0" style="letter-spacing: -0.5px;">📅 Schedule Showtime</h1>
                <p class="text-secondary small mb-0">Assign a movie to a cinema hall, time slot, and ticket price.</p>
            </div>
            <a asp-action="Index" class="btn btn-sm px-3 py-2 rounded-2 fw-semibold screening-btn-muted">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-light small mb-1">Select Movie</label>
                <select asp-for="MovieId" class="form-select screening-input" asp-items="ViewBag.MovieId"></select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold text-light small mb-1">Date and Time</label>
                    <input asp-for="Showtime" class="form-control screening-input" type="datetime-local"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="Showtime" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold text-light small mb-1">Base Ticket Price (EUR)</label>
                    <input asp-for="Price" class="form-control screening-input" type="number" step="0.50" value="5.00" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-light small mb-1">Cinema Hall</label>
                <input asp-for="HallName" class="form-control screening-input" placeholder="e.g. Hall 1" value="Hall 1" />
                <span asp-validation-for="HallName" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 pt-2 border-top border-secondary border-opacity-10">
                <button type="submit" class="btn px-4 py-2 rounded-2 fw-semibold screening-submit-btn">
                    Save Showtime <i class="bi bi-rocket-takeoff ms-1"></i>
                </button>
                <a asp-action="Index" class="btn px-4 py-2 rounded-2 fw-semibold screening-btn-muted">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .screening-form-card {
        background-color: #0d0f14 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }

    .screening-input {
        background-color: #14171f !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

        .screening-input:focus {
            background-color: #14171f !important;
            border-color: #ff6b00 !important;
            color: #ffffff !important;
            box-shadow: 0 0 0 0.25rem rgba(255, 107, 0, 0.15);
        }

    .screening-submit-btn {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

        .screening-submit-btn:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            box-shadow: 0 0 12px rgba(255, 107, 0, 0.4);
        }

    .screening-btn-muted {
        background-color: #14171f !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: #9ca3af !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

        .screening-btn-muted:hover {
            background-color: #1a1e28 !important;
            color: #ffffff !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }
</style>