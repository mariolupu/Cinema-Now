@model IEnumerable<WebApplication1.Models.Promotion>

@{
    ViewData["Title"] = "Manage Promotions";
}

<div class="container py-5 text-light" style="max-width: 1100px; min-height: 85vh;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-10 gap-3">
        <div>
            <h1 class="fw-bold text-white fs-3 m-0" style="letter-spacing: -0.5px;">⚙️ Manage Promotions & Offers</h1>
            <p class="text-secondary small mb-0">Add, edit, or remove promotional banners shown in the main carousel.</p>
        </div>
        <a asp-action="Create" class="btn btn-sm px-4 py-2 rounded-2 fw-semibold promo-add-btn">
            <i class="bi bi-plus-lg me-1"></i> Add New Promotion
        </a>
    </div>

    <div class="card border-0 promo-card rounded-3 shadow-lg overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 promo-table">
                <thead>
                    <tr>
                        <th class="py-3 ps-4">Badge</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Discount / Price</th>
                        <th class="py-3">Days</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge promo-badge px-2.5 py-1">@item.BadgeText</span>
                                </td>
                                <td class="fw-bold text-white">@item.Title</td>
                                <td>
                                    @if (item.DiscountPercentage.HasValue)
                                    {
                                        <span class="text-success fw-semibold" style="color: #34d399 !important;">@item.DiscountPercentage% OFF</span>
                                    }
                                    else if (item.FixedPrice.HasValue)
                                    {
                                        <span class="text-info fw-semibold" style="color: #38bdf8 !important;">@item.FixedPrice RON</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">Standard</span>
                                    }
                                </td>
                                <td class="text-secondary small">@(string.IsNullOrEmpty(item.ApplicableDays) ? "All days" : item.ApplicableDays)</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge promo-badge-success px-2.5 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge promo-badge-inactive px-2.5 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this promotion?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-3 fw-semibold promo-delete-btn">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                No promotional offers configured yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .text-cinema-orange {
        color: #ff6b00 !important;
    }

    .promo-add-btn {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

        .promo-add-btn:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            box-shadow: 0 0 10px rgba(255, 107, 0, 0.4);
        }

    .promo-card {
        background-color: #0d0f14 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }

    .promo-table {
        background-color: #0d0f14 !important;
    }

        .promo-table th {
            background-color: #14171f !important;
            color: #9ca3af !important;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .promo-table td {
            border-color: rgba(255, 255, 255, 0.08) !important;
            background-color: transparent !important;
            color: #e5e7eb !important;
            font-size: 0.9rem;
        }

        .promo-table tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.02) !important;
        }

    .promo-badge {
        background-color: #14171f !important;
        color: #ff6b00 !important;
        border: 1px solid rgba(255, 107, 0, 0.3);
        font-size: 0.75rem;
    }

    .promo-badge-success {
        background-color: rgba(16, 185, 129, 0.15) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-size: 0.75rem;
    }

    .promo-badge-inactive {
        background-color: rgba(107, 114, 128, 0.15) !important;
        color: #9ca3af !important;
        border: 1px solid rgba(107, 114, 128, 0.3);
        font-size: 0.75rem;
    }

    .promo-delete-btn {
        background-color: transparent !important;
        border-color: rgba(239, 68, 68, 0.3) !important;
        color: #f87171 !important;
        font-size: 0.8rem;
        transition: all 0.2s ease;
    }

        .promo-delete-btn:hover {
            background-color: rgba(239, 68, 68, 0.15) !important;
            border-color: #ef4444 !important;
            color: #ef4444 !important;
        }
</style>