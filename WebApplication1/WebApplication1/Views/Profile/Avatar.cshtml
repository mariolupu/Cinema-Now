@{
    ViewData["Title"] = "Edit Profile Picture";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border border-secondary border-opacity-25 shadow-lg" style="background-color: #0e0e0e;">
                <div class="card-body p-4 text-center">
                    <h4 class="text-white fw-bold mb-1">Profile Picture</h4>
                    <p class="text-secondary small mb-4">Allowed formats: .jpg, .jpeg, .png (Max 12 MB)</p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success py-2 small">@TempData["Success"]</div>
                    }

                    <div class="mb-4">
                        @if (ViewBag.AvatarUrl != null)
                        {
                            <img src="@ViewBag.AvatarUrl" alt="Avatar" class="rounded-circle border border-2 shadow-sm"
                                 style="width: 115px; height: 115px; object-fit: cover; border-color: #ff6b00 !important;" />
                        }
                        else
                        {
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center border border-secondary"
                                 style="width: 115px; height: 115px; background-color: #1a1a1a;">
                                <i class="bi bi-person-fill text-secondary" style="font-size: 3rem;"></i>
                            </div>
                        }
                    </div>

                    <form asp-controller="Profile" asp-action="Avatar" method="post" enctype="multipart/form-data">
                        <div class="mb-3 text-start">
                            <input type="file" name="avatarFile" accept=".jpg,.jpeg,.png" class="form-control bg-dark text-light border-secondary" required />
                        </div>
                        <button type="submit" class="btn btn-cinema-orange w-100 py-2 mb-2">
                            <i class="bi bi-upload me-1"></i> Save Photo
                        </button>
                    </form>

                    @if (ViewBag.AvatarUrl != null)
                    {
                        <form asp-controller="Profile" asp-action="RemoveAvatar" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100 py-2 small">
                                <i class="bi bi-trash-fill me-1"></i> Remove Photo
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>