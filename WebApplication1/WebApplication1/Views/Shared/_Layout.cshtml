@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" style="background-color: #050505 !important;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Now</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cinema-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="https://fonts.cdnfonts.com/css/milker" rel="stylesheet">

    <style>
            body.cinema-theme {
                background-color: #050505 !important;
                color: #f1f1f1 !important;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                overflow-x: hidden;
            }

            .brand-cinema-title {
                font-family: 'Milker', 'Impact', sans-serif;
                font-weight: 400;
                font-size: 1.4rem;
                letter-spacing: 1px;
                text-transform: uppercase;
                line-height: 1;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .brand-cinema-title .brand-main {
                    color: #ffffff;
                }

                .brand-cinema-title .brand-orange {
                    color: #ff6b00;
                }

            .navbar-cinema {
                background-color: #000000 !important;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.95);
            }

            .nav-link-cinema {
                color: #e0e0e0 !important;
                font-weight: 600;
                font-size: 0.85rem;
                transition: all 0.2s ease-in-out;
            }

                .nav-link-cinema:hover {
                    color: #ff6b00 !important;
                }

            .btn-admin-panel {
                color: #ff6b00 !important;
                font-weight: 600;
                font-size: 0.85rem;
                transition: all 0.2s ease-in-out;
            }

            .btn-cinema-orange {
                background-color: #ff6b00 !important;
                border: 1px solid #ff6b00 !important;
                color: #000000 !important;
                font-weight: 700;
                border-radius: 4px !important;
                transition: all 0.2s ease-in-out;
            }

                .btn-cinema-orange:hover {
                    background-color: #e56000 !important;
                    border-color: #e56000 !important;
                    color: #000000 !important;
                }

            .cinema-footer {
                background-color: #000000 !important;
            }

            .hover-orange:hover {
                color: #ff6b00 !important;
            }

            .navbar-container-flex {
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                flex-wrap: nowrap !important;
                width: 100%;
            }

            .navbar-nav-horizontal {
                display: flex !important;
                flex-direction: row !important;
                align-items: center !important;
                margin-bottom: 0 !important;
                list-style: none;
                padding-left: 0;
            }

            .user-account-name {
                white-space: nowrap !important;
                overflow: visible !important;
                text-overflow: clip !important;
                font-size: 0.78rem !important;
            }

            .navbar-toggler-custom {
                display: none !important;
            }

            @@media (max-width: 575.98px) {
                .brand-cinema-title {
                    font-size: 1.05rem !important;
                    gap: 4px;
                }

                .nav-link-cinema, .btn-admin-panel, .my-bookings-text {
                    font-size: 0.75rem !important;
                }
            }

            @@media (max-width: 519.98px) {
                .navbar-container-flex {
                    flex-wrap: wrap !important;
                }

                .navbar-toggler-custom {
                    display: block !important;
                }

                .collapse-on-mobile {
                    display: none;
                    width: 100%;
                    flex-direction: column !important;
                    align-items: flex-start !important;
                    background-color: #000000;
                    padding: 1rem;
                    margin-top: 0.5rem;
                    border-radius: 6px;
                    border: 1px solid rgba(255, 107, 0, 0.3);
                }

                    .collapse-on-mobile.show {
                        display: flex !important;
                    }

                .mobile-stack-group {
                    flex-direction: column !important;
                    align-items: flex-start !important;
                    width: 100%;
                    gap: 0.5rem !important;
                }

                .navbar-nav-horizontal {
                    flex-direction: column !important;
                    align-items: flex-start !important;
                    width: 100%;
                }

                .user-account-name {
                    font-size: 0.75rem !important;
                }
            }

            @@media (min-width: 520px) {
                .collapse-on-mobile {
                    display: flex !important;
                    width: auto !important;
                    flex-direction: row !important;
                    align-items: center !important;
                    background: transparent !important;
                    border: none !important;
                    padding: 0 !important;
                    margin: 0 !important;
                }

                .mobile-stack-group {
                    flex-direction: row !important;
                    align-items: center !important;
                }
            }
    </style>
</head>
<body class="cinema-theme text-light d-flex flex-column min-vh-100" style="background-color: #050505 !important;">
    <header class="sticky-top">
        <nav class="navbar navbar-dark navbar-cinema border-bottom border-secondary border-opacity-25 py-2.5 py-md-3">
            <div class="container-fluid px-2 px-md-4 navbar-container-flex">

                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <a class="navbar-brand p-0 m-0" asp-area="" asp-controller="Movies" asp-action="Index">
                        <div class="brand-cinema-title">
                            <span></span>
                            <span class="brand-main">CINEMA</span>
                            <span class="brand-orange">NOW</span>
                        </div>
                    </a>

                    <div class="collapse collapse-on-mobile mobile-stack-group gap-2 gap-md-3">
                        <ul class="navbar-nav-horizontal gap-1 gap-md-2">
                            <li>
                                <a class="nav-link nav-link-cinema px-1 px-md-2 py-1" asp-area="" asp-controller="Movies" asp-action="Index">
                                    <i class="bi bi-film"></i> Movies
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="nav-link btn-admin-panel px-1 px-md-2 py-1" asp-area="" asp-controller="Movies" asp-action="Admin">
                                        <i class="bi bi-speedometer2"></i> Admin
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <button class="navbar-toggler navbar-toggler-custom border-0 shadow-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#cinemaMobileMenu" aria-controls="cinemaMobileMenu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse collapse-on-mobile mobile-stack-group gap-1 gap-md-2 ms-auto" id="cinemaMobileMenu">
                        <ul class="navbar-nav-horizontal gap-1 gap-md-2 align-items-center">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li>
                                    <a class="nav-link text-light fw-semibold d-flex align-items-center gap-1 px-1 px-md-2 py-1 hover-orange"
                                       asp-area=""
                                       asp-controller="Bookings"
                                       asp-action="MyBookings"
                                       title="My Bookings">
                                        <i class="bi bi-ticket-perforated fs-6"></i>
                                        <span class="my-bookings-text" style="font-size: 0.8rem;">Bookings</span>
                                    </a>
                                </li>

                                <li class="d-flex align-items-center gap-1 border-start border-secondary border-opacity-25 ps-1.5 ps-md-2">
                                    <a class="nav-link text-white fw-semibold d-flex align-items-center gap-1 p-0 hover-orange"
                                       asp-area="Identity"
                                       asp-page="/Account/Manage/Index"
                                       title="Manage Account">
                                        @{
                                            var currentUserId = UserManager.GetUserId(User);
                                            var avatarDir = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "avatars");
                                            var avatarFile = System.IO.Directory.Exists(avatarDir)
                                                ? System.IO.Directory.GetFiles(avatarDir, $"{currentUserId}.*").FirstOrDefault()
                                                : null;
                                        }
                                        @if (avatarFile != null)
                                        {
                                            <img src="/uploads/avatars/@System.IO.Path.GetFileName(avatarFile)" alt="Avatar"
                                                 class="rounded-circle border" style="width: 26px; height: 26px; object-fit: cover; border-color: #ff6b00 !important;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-fill text-secondary fs-6"></i>
                                        }
                                        <span class="text-light user-account-name">@User.Identity?.Name</span>
                                    </a>

                                    <a asp-area="" asp-controller="Profile" asp-action="Avatar"
                                       class="btn btn-sm p-1 px-1.5 border border-secondary border-opacity-50 rounded-1 hover-orange ms-1"
                                       style="color: #ff6b00; font-size: 0.7rem;"
                                       title="Edit Profile Picture">
                                        <i class="bi bi-camera-fill"></i>
                                    </a>
                                </li>

                                <li>
                                    <form class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Movies", new { area = "" })">
                                        <button type="submit" class="btn btn-outline-light btn-sm rounded-1 px-1.5 px-md-2 fw-semibold shadow-sm" style="font-size: 0.75rem; white-space: nowrap;">
                                            <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="nav-link text-white fw-semibold px-1 px-md-2 hover-orange" style="font-size: 0.8rem;" asp-area="Identity" asp-page="/Account/Register">Register</a>
                                </li>
                                <li>
                                    <a class="btn btn-cinema-orange btn-sm fw-bold rounded-1 px-2 px-md-3" style="font-size: 0.78rem; white-space: nowrap;" asp-area="Identity" asp-page="/Account/Login">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <div class="main-wrapper flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="cinema-footer border-top border-secondary border-opacity-25 text-muted py-4 mt-auto">
        <div class="container text-center">
            <div class="mb-2">
                <span class="fw-bold text-light">🎬 CINEMA NOW</span> •
                <span class="text-cinema-orange fw-semibold">The Ultimate Movie Experience</span>
            </div>
            <p class="small mb-0 text-secondary">
                © 2026 Cinema Now Entertainment. All rights reserved. •
                <a asp-area="" asp-controller="Movies" asp-action="Privacy" class="text-decoration-none text-secondary hover-orange">Privacy Policy</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>