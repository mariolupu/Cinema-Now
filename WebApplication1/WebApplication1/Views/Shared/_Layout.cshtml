@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Now</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cinema-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Import font Milker -->
    <link href="https://fonts.cdnfonts.com/css/milker" rel="stylesheet">

    <style>
            body.cinema-theme {
                background-color: #050505 !important;
                color: #f1f1f1 !important;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            }

            /* Branding Cinema Now cu fontul Milker */
            .brand-cinema-title {
                font-family: 'Milker', 'Impact', sans-serif;
                font-weight: 400;
                font-size: 1.7rem;
                letter-spacing: 2px;
                text-transform: uppercase;
                line-height: 1;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .brand-cinema-title .brand-main {
                    color: #ffffff;
                }

                .brand-cinema-title .brand-orange {
                    color: #ff6b00;
                }

            .navbar-cinema {
                background-color: #000000 !important;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.95);
            }

            .nav-link-cinema {
                color: #e0e0e0 !important;
                font-weight: 600;
                transition: all 0.2s ease-in-out;
            }

                .nav-link-cinema:hover {
                    color: #ff6b00 !important;
                }

            /* Admin Panel Button */
            .btn-admin-panel {
                color: #ff6b00 !important;
                font-weight: 600;
                transition: all 0.2s ease-in-out;
                text-shadow: 0 0 5px rgba(255, 107, 0, 0.2);
            }

                .btn-admin-panel:hover {
                    color: #ff8533 !important;
                    font-weight: 800 !important;
                    text-shadow: 0 0 10px rgba(255, 107, 0, 0.6);
                }

            /* Buton principal portocaliu */
            .btn-cinema-orange {
                background-color: #ff6b00 !important;
                border: 1px solid #ff6b00 !important;
                color: #000000 !important;
                font-weight: 700;
                border-radius: 4px !important;
                transition: all 0.2s ease-in-out;
            }

                .btn-cinema-orange:hover {
                    background-color: #e56000 !important;
                    border-color: #e56000 !important;
                    color: #000000 !important;
                    box-shadow: 0 0 12px rgba(255, 107, 0, 0.4);
                }

            .cinema-footer {
                background-color: #000000 !important;
            }

            .hover-orange:hover {
                color: #ff6b00 !important;
            }
    </style>
</head>
<body class="cinema-theme text-light d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark navbar-cinema border-bottom border-secondary border-opacity-25 py-2">
            <div class="container-fluid px-4">
                <!-- Logo -->
                <a class="navbar-brand p-0" asp-area="" asp-controller="Movies" asp-action="Index">
                    <div class="brand-cinema-title">
                        <span class="fs-4">🎬</span>
                        <span class="brand-main">CINEMA</span>
                        <span class="brand-orange">NOW</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between ms-3">
                    <!-- Stânga: Movies & Admin -->
                    <ul class="navbar-nav flex-grow-1 ms-2 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-cinema px-3" asp-area="" asp-controller="Movies" asp-action="Index">
                                <i class="bi bi-film me-1"></i> Movies
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link btn-admin-panel px-3" asp-area="" asp-controller="Movies" asp-action="Admin">
                                    <i class="bi bi-speedometer2 me-1"></i> Admin Panel
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Dreapta (Unic): My Bookings, Cont, Avatar și Login/Logout -->
                    <ul class="navbar-nav align-items-center gap-2 ms-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <!-- My Bookings -->
                            <li class="nav-item">
                                <a class="nav-link text-light fw-semibold d-flex align-items-center gap-1 px-2 hover-orange"
                                   asp-area=""
                                   asp-controller="Bookings"
                                   asp-action="MyBookings"
                                   title="My Ticket History">
                                    <i class="bi bi-ticket-perforated me-1 fs-5"></i>
                                    <span>My Bookings</span>
                                </a>
                            </li>

                            <!-- My Account + Poză Profil + Buton Editare -->
                            <li class="nav-item d-flex align-items-center gap-2 border-start border-secondary border-opacity-25 ps-3">
                                <a class="nav-link text-white fw-semibold d-flex align-items-center gap-2 p-0 hover-orange"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/Index"
                                   title="Manage Account">
                                    @{
                                        var currentUserId = UserManager.GetUserId(User);
                                        var avatarDir = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "avatars");
                                        var avatarFile = System.IO.Directory.Exists(avatarDir)
                                            ? System.IO.Directory.GetFiles(avatarDir, $"{currentUserId}.*").FirstOrDefault()
                                            : null;
                                    }
                                    @if (avatarFile != null)
                                    {
                                        <img src="/uploads/avatars/@System.IO.Path.GetFileName(avatarFile)" alt="Avatar"
                                             class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover; border-color: #ff6b00 !important;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill text-secondary fs-5"></i>
                                    }
                                    <div class="d-flex flex-column lh-1">
                                        <span class="text-secondary text-uppercase fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">My Account</span>
                                        <span class="text-light small">@User.Identity?.Name</span>
                                    </div>
                                </a>

                                <!-- Buton editare poză profil -->
                                <a asp-area="" asp-controller="Profile" asp-action="Avatar"
                                   class="btn btn-sm p-1 px-2 border border-secondary border-opacity-50 rounded-1 hover-orange"
                                   style="color: #ff6b00;"
                                   title="Edit Profile Picture">
                                    <i class="bi bi-camera-fill small"></i>
                                </a>
                            </li>

                            <!-- Logout -->
                            <li class="nav-item ms-1">
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Movies", new { area = "" })">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-1 px-3 fw-semibold shadow-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold px-3 hover-orange" asp-area="Identity" asp-page="/Account/Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-cinema-orange btn-sm fw-bold rounded-1 px-3" asp-area="Identity" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="cinema-footer border-top border-secondary border-opacity-25 text-muted py-4 mt-auto">
        <div class="container text-center">
            <div class="mb-2">
                <span class="fw-bold text-light">🎬 CINEMA NOW</span> •
                <span class="text-cinema-orange fw-semibold">The Ultimate Movie Experience</span>
            </div>
            <p class="small mb-0 text-secondary">
                © 2026 Cinema Now Entertainment. All rights reserved. •
                <a asp-area="" asp-controller="Movies" asp-action="Privacy" class="text-decoration-none text-secondary hover-orange">Privacy Policy</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>