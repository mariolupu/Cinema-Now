@model IEnumerable<WebApplication1.Models.Booking>

@{
    ViewData["Title"] = "My Ticket History";

    var now = DateTime.Now;

    var activeBookings = new List<WebApplication1.Models.Booking>();
    var cancelledOrExpiredBookings = new List<WebApplication1.Models.Booking>();
    var pastBookings = new List<WebApplication1.Models.Booking>();

    if (Model != null)
    {
        foreach (var b in Model)
        {
            var screeningTime = b.Screening?.Showtime ?? now;
            var durationMinutes = b.Screening?.Movie?.Duration ?? 120;
            var movieEndTime = screeningTime.AddMinutes(durationMinutes);

            bool isUnpaidAndExpired = !b.IsPaid && now > screeningTime.AddMinutes(30);

            if ((b.IsCancelled || isUnpaidAndExpired) && now > movieEndTime)
            {
                pastBookings.Add(b);
            }
            else if (b.IsCancelled || isUnpaidAndExpired)
            {
                cancelledOrExpiredBookings.Add(b);
            }
            else if (now > movieEndTime)
            {
                pastBookings.Add(b);
            }
            else
            {
                activeBookings.Add(b);
            }
        }
    }
}

<div class="container py-5 text-light" style="max-width: 950px; min-height: 85vh;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-10">
        <div>
            <h1 class="fw-bold text-white fs-3 m-0" style="letter-spacing: -0.5px;">🎟️ My Ticket History</h1>
            <p class="text-secondary small mb-0">Manage your active reservations, payments, and past cinematic experiences.</p>
        </div>
        <a asp-controller="Movies" asp-action="Index" class="btn btn-sm px-3 py-2 rounded-2 fw-semibold ticket-btn-muted">
            <i class="bi bi-arrow-left me-1"></i> Back to Catalog
        </a>
    </div>

    <div class="p-3 rounded-3 mb-4 d-flex align-items-start gap-3 ticket-notice-box">
        <i class="bi bi-info-circle-fill text-cinema-orange fs-5 mt-1"></i>
        <div class="small text-secondary lh-sm">
            <span class="text-light fw-semibold">Important Policy:</span> Unpaid reservations must be paid online or presented at the cinema box office at least <strong class="text-white">30 minutes before showtime</strong>, otherwise they will be automatically cancelled. Online paid tickets cannot be refunded once confirmed.
        </div>
    </div>

    <ul class="nav nav-pills mb-4 gap-2 border-bottom border-secondary border-opacity-10 pb-3" id="ticketTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 rounded-2 fw-semibold small" id="active-tab" data-bs-toggle="pill" data-bs-target="#active" type="button" role="tab">
                Active Tickets <span class="badge bg-secondary ms-1">@activeBookings.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 rounded-2 fw-semibold small" id="cancelled-tab" data-bs-toggle="pill" data-bs-target="#cancelled" type="button" role="tab">
                Cancelled / Unpaid <span class="badge bg-secondary ms-1">@cancelledOrExpiredBookings.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 rounded-2 fw-semibold small" id="past-tab" data-bs-toggle="pill" data-bs-target="#past" type="button" role="tab">
                Past History <span class="badge bg-secondary ms-1">@pastBookings.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="ticketTabsContent">

        <div class="tab-pane fade show active" id="active" role="tabpanel">
            @if (activeBookings.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in activeBookings)
                    {
                        var totalSeatsCount = string.IsNullOrEmpty(item.SeatNumbers) ? 0 : item.SeatNumbers.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                        var standardTicketsCount = Math.Max(0, totalSeatsCount - item.StudentTickets - item.ChildTickets);

                        <div class="card p-3 shadow-sm ticket-card rounded-3 text-light">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center mb-3 mb-md-0">
                                    <div class="ticket-poster-wrapper rounded-2 overflow-hidden mx-auto">
                                        <img src="@(string.IsNullOrEmpty(item.Screening?.Movie?.ImageUrl) ? "https://picsum.photos/200/300" : item.Screening.Movie.ImageUrl)"
                                             class="w-100 h-100" style="object-fit: cover;" alt="Poster" />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <h5 class="fw-bold text-white mb-2 fs-6">@item.Screening?.Movie?.Title</h5>
                                    <div class="d-flex flex-column gap-1 small text-secondary">
                                        <div><i class="bi bi-calendar-event me-1 text-cinema-orange"></i> Showtime: <strong class="text-light">@item.Screening?.Showtime.ToString("dd MMM yyyy, HH:mm")</strong></div>
                                        <div><i class="bi bi-geo-alt me-1 text-cinema-orange"></i> Hall: <strong class="text-light">@item.Screening?.HallName</strong></div>
                                        <div>
                                            <i class="bi bi-chair me-1 text-cinema-orange"></i> Seats: <strong class="text-cinema-orange">@item.SeatNumbers</strong>
                                            <span class="ms-2 text-white fw-bold">(@item.TotalAmount.ToString("0.00") EUR)</span>
                                        </div>
                                        <div class="mt-1">
                                            @if (standardTicketsCount > 0)
                                            {
                                                <span class="badge bg-dark border border-secondary text-light me-1" style="font-size: 0.7rem;">@standardTicketsCount Standard</span>
                                            }
                                            @if (item.StudentTickets > 0)
                                            {
                                                <span class="badge bg-dark border border-secondary text-light me-1" style="font-size: 0.7rem;">🎓 @item.StudentTickets Student</span>
                                            }
                                            @if (item.ChildTickets > 0)
                                            {
                                                <span class="badge bg-dark border border-secondary text-light" style="font-size: 0.7rem;">🧒 @item.ChildTickets Child (under 18)</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end d-flex flex-column align-items-md-end justify-content-center gap-2">
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge ticket-badge-success px-3 py-2 fw-semibold">Paid & Confirmed (@item.PaymentMethod)</span>
                                        <span class="text-secondary" style="font-size: 0.7rem;">Booked on @item.BookingDate.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="badge ticket-badge-warning px-3 py-2 fw-semibold">Pending Payment</span>
                                        <div class="d-flex gap-2 mt-1 flex-wrap justify-content-md-end">
                                            <form asp-controller="Bookings" asp-action="CreateCheckoutSession" method="post" class="m-0">
                                                <input type="hidden" name="bookingId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm px-3 py-1 rounded-2 fw-semibold ticket-pay-btn">
                                                    <i class="bi bi-credit-card me-1"></i> Pay Stripe
                                                </button>
                                            </form>
                                            <form asp-controller="Bookings" asp-action="CancelBooking" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to cancel this unpaid reservation?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm px-3 py-1 rounded-2 fw-semibold ticket-cancel-btn">
                                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                                </button>
                                            </form>
                                        </div>
                                        <span class="text-secondary mt-1" style="font-size: 0.7rem;">Pay 30 min before showtime</span>
                                    }
                                </div>
                            </div>

                            @if (item.StudentTickets > 0)
                            {
                                <div class="mt-3 pt-2 border-top border-secondary border-opacity-10 d-flex align-items-start gap-2 small text-light">
                                    <i class="bi bi-person-vcard-fill text-cinema-orange mt-0.5"></i>
                                    <span style="font-size: 0.78rem;">
                                        <strong>Student Verification Required:</strong> Since this reservation includes <strong class="text-cinema-orange">@item.StudentTickets student ticket(s)</strong>, valid student ID cards must be presented at the counter or to cinema staff upon entry.
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 ticket-empty-card rounded-3">
                    <p class="text-secondary small mb-0">You have no active ticket reservations right now.</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="cancelled" role="tabpanel">
            @if (cancelledOrExpiredBookings.Any())
            {
                <div class="d-flex flex-column gap-3 opacity-75">
                    @foreach (var item in cancelledOrExpiredBookings)
                    {
                        <div class="card p-3 shadow-sm ticket-card rounded-3 text-light">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center mb-3 mb-md-0">
                                    <div class="ticket-poster-wrapper rounded-2 overflow-hidden mx-auto">
                                        <img src="@(string.IsNullOrEmpty(item.Screening?.Movie?.ImageUrl) ? "https://picsum.photos/200/300" : item.Screening.Movie.ImageUrl)"
                                             class="w-100 h-100" style="object-fit: cover;" alt="Poster" />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <h5 class="fw-bold text-white mb-2 fs-6">@item.Screening?.Movie?.Title</h5>
                                    <div class="d-flex flex-column gap-1 small text-secondary">
                                        <div><i class="bi bi-calendar-event me-1 text-cinema-orange"></i> Showtime: <strong class="text-light">@item.Screening?.Showtime.ToString("dd MMM yyyy, HH:mm")</strong></div>
                                        <div><i class="bi bi-geo-alt me-1 text-cinema-orange"></i> Hall: <strong class="text-light">@item.Screening?.HallName</strong></div>
                                        <div><i class="bi bi-chair me-1 text-cinema-orange"></i> Seats: <strong class="text-cinema-orange">@item.SeatNumbers</strong></div>
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end d-flex flex-column align-items-md-end justify-content-center gap-2">
                                    <span class="badge ticket-badge-danger px-3 py-2 fw-semibold">Cancelled / Expired</span>
                                    <span class="text-secondary" style="font-size: 0.7rem;">Unpaid timeout exceeded</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 ticket-empty-card rounded-3">
                    <p class="text-secondary small mb-0">No cancelled or expired unpaid reservations found.</p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="past" role="tabpanel">
            @if (pastBookings.Any())
            {
                <div class="d-flex flex-column gap-3 opacity-75">
                    @foreach (var item in pastBookings)
                    {
                        var screeningTime = item.Screening?.Showtime ?? now;
                        var durationMinutes = item.Screening?.Movie?.Duration ?? 120;
                        var movieEndTime = screeningTime.AddMinutes(durationMinutes);
                        bool isUnpaidAndExpired = !item.IsPaid && now > screeningTime.AddMinutes(30);
                        bool isCancelledOrExpired = item.IsCancelled || isUnpaidAndExpired;

                        <div class="card p-3 shadow-sm ticket-card rounded-3 text-light">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center mb-3 mb-md-0">
                                    <div class="ticket-poster-wrapper rounded-2 overflow-hidden mx-auto">
                                        <img src="@(string.IsNullOrEmpty(item.Screening?.Movie?.ImageUrl) ? "https://picsum.photos/200/300" : item.Screening.Movie.ImageUrl)"
                                             class="w-100 h-100" style="object-fit: cover;" alt="Poster" />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <h5 class="fw-bold text-white mb-2 fs-6">@item.Screening?.Movie?.Title</h5>
                                    <div class="d-flex flex-column gap-1 small text-secondary">
                                        <div><i class="bi bi-calendar-event me-1 text-cinema-orange"></i> Showtime: <strong class="text-light">@item.Screening?.Showtime.ToString("dd MMM yyyy, HH:mm")</strong></div>
                                        <div><i class="bi bi-geo-alt me-1 text-cinema-orange"></i> Hall: <strong class="text-light">@item.Screening?.HallName</strong></div>
                                        <div><i class="bi bi-chair me-1 text-cinema-orange"></i> Seats: <strong class="text-cinema-orange">@item.SeatNumbers</strong></div>
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end d-flex flex-column align-items-md-end justify-content-center gap-2">
                                    @if (isCancelledOrExpired)
                                    {
                                        <span class="badge ticket-badge-danger px-3 py-2 fw-semibold">Cancelled</span>
                                        <span class="text-secondary" style="font-size: 0.7rem;">Screening time passed</span>
                                    }
                                    else
                                    {
                                        <span class="badge ticket-badge-success px-3 py-2 fw-semibold">Completed</span>
                                        <span class="text-secondary" style="font-size: 0.7rem;">Screening finished</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 ticket-empty-card rounded-3">
                    <p class="text-secondary small mb-0">No past movie history recorded yet.</p>
                </div>
            }
        </div>

    </div>
</div>

<style>
    .text-cinema-orange {
        color: #ff6b00 !important;
    }

    .ticket-card {
        background-color: #0d0f14 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transition: border-color 0.2s ease;
    }

        .ticket-card:hover {
            border-color: rgba(255, 107, 0, 0.3) !important;
        }

    .ticket-empty-card {
        background-color: #0d0f14 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }

    .ticket-notice-box {
        background-color: #0d0f14 !important;
        border: 1px solid rgba(255, 107, 0, 0.2) !important;
    }

    .ticket-poster-wrapper {
        width: 70px;
        height: 95px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-pills .nav-link {
        background-color: #0d0f14 !important;
        color: #9ca3af !important;
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.2s ease;
    }

        .nav-pills .nav-link:hover {
            color: #ffffff !important;
            border-color: rgba(255, 255, 255, 0.2);
        }

        .nav-pills .nav-link.active {
            background-color: #ff6b00 !important;
            color: #ffffff !important;
            border-color: #ff6b00 !important;
        }

    .ticket-badge-success {
        background-color: rgba(16, 185, 129, 0.15) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-size: 0.75rem;
    }

    .ticket-badge-warning {
        background-color: rgba(245, 158, 11, 0.15) !important;
        color: #fbbf24 !important;
        border: 1px solid rgba(245, 158, 11, 0.3);
        font-size: 0.75rem;
    }

    .ticket-badge-danger {
        background-color: rgba(239, 68, 68, 0.15) !important;
        color: #f87171 !important;
        border: 1px solid rgba(239, 68, 68, 0.3);
        font-size: 0.75rem;
    }

    .ticket-pay-btn {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        font-size: 0.75rem;
        transition: all 0.2s ease;
    }

        .ticket-pay-btn:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            box-shadow: 0 0 8px rgba(255, 107, 0, 0.4);
        }

    .ticket-cancel-btn {
        background-color: #14171f !important;
        border: 1px solid rgba(239, 68, 68, 0.3) !important;
        color: #f87171 !important;
        font-size: 0.75rem;
        transition: all 0.2s ease;
    }

        .ticket-cancel-btn:hover {
            background-color: rgba(239, 68, 68, 0.15) !important;
            border-color: #ef4444 !important;
            color: #ef4444 !important;
        }

    .ticket-btn-muted {
        background-color: #14171f !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: #9ca3af !important;
        transition: all 0.2s ease;
    }

        .ticket-btn-muted:hover {
            background-color: #1a1e28 !important;
            color: #ffffff !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }
</style>